# cp .env.example .env  ve değerleri değiştir
JWT_SECRET=buraya-uzun-rastgele-bir-anahtar-yaz
DB_PASSWORD=tosso
SEED=true
# Harita stili; varsayılan nginx'teki önbellekli vekil (/map/styles/liberty)
# MAP_STYLE=/map/styles/liberty

# Google Play satın alma doğrulaması: paket adı ve servis hesabı JSON'u
GOOGLE_PLAY_PACKAGE=
GOOGLE_PLAY_SERVICE_ACCOUNT=

# Admin paneline (/admin) girebilecek kullanıcı adları, virgülle
ADMIN_USERNAMES=
